    var again = function () { return openTab(A.tab); };
    if (a === "tab") return openTab(k);
    if (a === "mfilt") { A.memFilter = b.getAttribute("data-f"); return render(); }
    if (a === "adm-add") {
      var em = ($("#adx-email").value || "").trim(), rs = $$(".adx-rc").filter(function (c) { return c.checked; }).map(function (c) { return c.value; });
