    if (c.getAttribute && c.getAttribute("data-a") === "role-perm") {
      var role = c.getAttribute("data-r"), perm = c.getAttribute("data-p"), on = c.checked;
      rpc("role_perm_set", { p_role: role, p_perm: perm, p_on: on }).then(function () { tip("Permission mise à jour."); }).catch(function (err) { c.checked = !on; fail(err); });
    }
  }

  /* ---------- Modération Automatique & Filtre de Contenu ---------- */
  function moderateText(text) {
    var badWords = ["arnaque", "faux", "escroc"]; // Mots interdits ou sensibles filtrés automatiquement
    var clean = text;
    badWords.forEach(function (w) {
      var regex = new RegExp(w, "gi");
      clean = clean.replace(regex, "[Modéré]");
    });
    return clean;
  }
  window.BTP_MOD = { check: moderateText };

  /* ---------- Bouton d'ouverture dans l'onglet Compte ---------- */
  function legacyAdminVisible() { var l = $("#sub-admin-btn"); return !!(l && !l.classList.contains("hidden")); }
  function accountBox(kind, msg) {
    var role = $("#role"), host = role && role.parentNode;
    if (!host) return;
    var box = $("#adx-open-box");
    if (!box) { box = document.createElement("div"); box.id = "adx-open-box"; box.style.marginTop = "12px"; host.appendChild(box); }
    if (kind === "ok") {
      box.innerHTML = '<button type="button" id="adx-open" class="btn">🛡️ Ouvrir la console avancée</button>';
      $("#adx-open").addEventListener("click", function () { if (btn) btn.click(); });
    } else {
      box.innerHTML = '<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:12px;padding:10px;font-size:13px">⚠️ ' + esc(msg) + "</div>";
    }
  }

  /* ---------- Initialisation ---------- */
  function start() {
    var c = client();
    if (!c) return;
    mount();
    loadFlags().then(function () { return rpc("my_access"); }).then(function (a) {
      A.acc = a || { is_admin: false };
      if (A.acc.is_admin) {
        if (btn) btn.style.display = "";
        accountBox("ok");
      }
      applyFlags();
    }).catch(function () {});
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start); else start();
})();
