      var why = v ? null : prompt("Motif de la désactivation ?"); if (!v && why === null) return;
      return run(rpc("admin_toggle", { p_user: u, p_active: v, p_reason: why }), v ? "Admin réactivé." : "Admin désactivé.", again);
    }
    if (a === "adm-role") return run(rpc("admin_role_toggle", { p_user: u, p_role: r, p_active: v }), "Rôle mis à jour.", again);
    if (a === "adm-rm") { if (!confirm("Retirer définitivement cet administrateur ?")) return; return run(rpc("admin_remove", { p_user: u }), "Administrateur retiré.", again); }
    if (a === "role-toggle") return run(rpc("role_toggle", { p_role: r, p_active: v }), "Rôle mis à jour.", again);
    if (a === "role-del") { if (!confirm("Supprimer ce rôle ?")) return; return run(rpc("role_delete", { p_key: r }), "Rôle supprimé.", again); }
    if (a === "role-new") {
      return run(rpc("role_create", { p_key: ($("#adx-rk").value || "").trim(), p_label: $("#adx-rl").value, p_desc: $("#adx-rd").value, p_icon: "🛡️" }), "Rôle créé.", again);
    }
    if (a === "flag") return run(rpc("flag_set", { p_key: k, p_enabled: v }), "Interrupteur mis à jour.", function () { return loadFlags().then(render); });
    if (a === "mem-search") {
      A.q = ($("#adx-q").value || "").trim();
      return rpc("member_lookup", { p_q: A.q }).then(function (d) { A.mem = d || []; render(); }).catch(fail);
    }
    if (a === "svc") {
      var reason = null, days = null, st = b.getAttribute("data-v");
      if (st === "suspended") {
        reason = prompt("Motif de la suspension de cette activité ?"); if (!reason) return;
        var d = prompt("Durée en jours (laisser vide = jusqu'à réactivation)"); days = d ? parseInt(d, 10) || null : null;
      }
      return run(rpc("service_set", { p_user: u, p_service: s, p_status: st, p_reason: reason, p_days: days }), "Activité mise à jour.",
        function () { return rpc("member_lookup", { p_q: A.q }).then(function (x) { A.mem = x || []; render(); }); });
    }
    if (a === "acc") {
      var st2 = b.getAttribute("data-v"), rs2 = null, dd = null;
      if (st2 !== "active") {
        rs2 = prompt("Motif ?"); if (!rs2) return;
        if (st2 === "suspended") { var x = prompt("Durée en jours (vide = illimitée)"); dd = x ? parseInt(x, 10) || null : null; }
      }
      return run(rpc("account_set", { p_user: u, p_status: st2, p_reason: rs2, p_days: dd }), "Compte mis à jour.",
        function () { return rpc("member_lookup", { p_q: A.q }).then(function (y) { A.mem = y || []; render(); }); });
    }
    if (a === "panic") {
      if (!confirm(v ? "Activer le verrou d'urgence ? Tous les admins (sauf vous) seront désactivés." : "Lever le verrou ?")) return;
      var rs3 = v ? prompt("Motif (facultatif)") : null;
      return run(rpc("panic_lock", { p_on: v, p_reason: rs3 }), v ? "Verrou activé." : "Verrou levé.", function () { return loadFlags().then(render); });
    }
  }
  function onChange(e) {
    var c = e.target;
    if (c.getAttribute && c.getAttribute("data-a") === "role-perm") {
      var role = c.getAttribute("data-r"), perm = c.getAttribute("data-p"), on = c.checked;
      rpc("role_perm_set", { p_role: role, p_perm: perm, p_on: on }).then(function () {
        var r = A.cat.roles.filter(function (x) { return x.key === role; })[0];
        if (r) { var i = r.perms.indexOf(perm); if (on && i < 0) r.perms.push(perm); if (!on && i >= 0) r.perms.splice(i, 1); }
        tip("Permission mise à jour.");
      }).catch(function (err) { c.checked = !on; fail(err); });
    }
  }

  /* ---------- « Mes activités » dans le profil du membre ---------- */
  var mine = {};
  function mySvcBox() {
    var host = $("#sub-profile"); if (!host || !A.acc || !A.acc.uid) return;
    var box = $("#adx-mine");
    if (!box) { box = document.createElement("div"); box.id = "adx-mine"; box.style.marginTop = "18px"; host.appendChild(box); }
    box.innerHTML = '<div class="sub">Mes activités</div><p class="small2">Une même personne peut proposer plusieurs activités. Une sanction sur l\'une ne touche pas les autres.</p>' +
      ["technician", "supplier", "rental"].filter(function (s) { return on("service_" + s); }).map(function (s) {
        var r = mine[s], line;
        if (!r) line = '<button type="button" class="ib" data-m="add" data-s="' + s + '">Activer</button>';
        else if (r.status === "active") line = '<span class="kb off">✅ Active' + (r.self_paused ? " (en pause)" : "") + '</span> <button type="button" class="ib" data-m="pause" data-s="' + s + '" data-v="' + (r.self_paused ? 0 : 1) + '">' + (r.self_paused ? "Reprendre" : "Mettre en pause") + "</button>";
        else if (r.status === "pending") line = '<span class="kb off">⏳ En attente de validation</span>';
        else line = '<span class="kb cl">⛔ ' + (r.status === "banned" ? "Bannie" : "Suspendue") + "</span>" + (r.reason ? '<div class="m">Motif : ' + esc(r.reason) + "</div>" : "") + (r.suspended_until ? '<div class="m">Jusqu\'au ' + dt(r.suspended_until) + "</div>" : "");
        return '<div class="sw"><div><b>' + SVC[s] + "</b></div><div>" + line + "</div></div>";
      }).join("");
  }
  function loadMine() {
    if (!A.acc || !A.acc.uid) return Promise.resolve();
    return client().from("member_services").select("*").eq("user_id", A.acc.uid).then(function (r) {
      mine = {}; (r.data || []).forEach(function (x) { mine[x.service] = x; });
      mySvcBox();
    });
  }
  document.addEventListener("click", function (e) {
    var b = e.target.closest("[data-m]"); if (!b || !A.acc || !A.acc.uid) return;
    var s = b.getAttribute("data-s"), c = client(), p;
    if (b.getAttribute("data-m") === "add") p = c.from("member_services").insert([{ user_id: A.acc.uid, service: s }]);
    else p = c.from("member_services").update({ self_paused: b.getAttribute("data-v") === "1" }).eq("user_id", A.acc.uid).eq("service", s);
    p.then(function (r) { if (r.error) return fail(r.error); tip("Activité mise à jour."); loadMine(); });
  });

  /* ---------- Annuaire : n'afficher que les activités actives ---------- */
  var activeSet = {}, activeReady = false;
  function loadActive() {
    return client().from("member_services").select("user_id,service,status,self_paused,suspended_until").then(function (r) {
      if (r.error) return;
      activeSet = {}; activeReady = true;
      (r.data || []).forEach(function (x) {
        var ok = x.status === "active" && !x.self_paused;
        if (ok && on("service_" + x.service)) activeSet[x.user_id + ":" + x.service] = true;
      });
    });
  }
  window.BTP_SVC = { active: function (uid, svc) { return !activeReady || !!activeSet[uid + ":" + svc]; } };

  /* ---------- Démarrage ---------- */
  function start() {
    var c = client(); if (!c) return;
    mount();
    loadFlags().then(function () { return rpc("my_access"); }).then(function (a) {
      A.acc = a || { is_admin: false };
      if (A.acc.is_admin && btn) btn.style.display = "";
      applyFlags();
      return Promise.all([loadMine().catch(function () {}), loadActive().catch(function () {})]);
    }).then(function () {
      var pq = $("#pq"); if (pq) pq.dispatchEvent(new Event("input"));
    }).catch(function () {});
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start); else start();
})();
