      return run(rpc("admin_add", { p_email: em, p_roles: rs }), "Administrateur enregistré.", again);
    }
    if (a === "adm-toggle") return run(rpc("admin_toggle", { p_user: u, p_active: v }), "Statut mis à jour.", again);
    if (a === "adm-role") return run(rpc("admin_role_toggle", { p_user: u, p_role: r, p_active: v }), "Rôle mis à jour.", again);
    if (a === "adm-rm") { if (!confirm("Retirer cet administrateur ?")) return; return run(rpc("admin_remove", { p_user: u }), "Retiré.", again); }
    if (a === "flag") return run(rpc("flag_set", { p_key: k, p_enabled: v }), "Option mise à jour.", function () { return loadFlags().then(render); });
    if (a === "mem-search") {
      A.q = ($("#adx-q").value || "").trim();
      return rpc("member_lookup", { p_q: A.q }).then(function (d) { A.mem = d || []; render(); }).catch(fail);
    }
    if (a === "svc") {
      return run(rpc("service_set", { p_user: u, p_service: s, p_status: b.getAttribute("data-v"), p_reason: null, p_days: null }), "Activité mise à jour.",
        function () { return rpc("member_lookup", { p_q: A.q }).then(function (x) { A.mem = x || []; render(); }); });
    }
    if (a === "panic") {
